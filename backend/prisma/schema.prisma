datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String
  passwordHash       String
  avatarUrl          String?
  termsAccepted      Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  media              Media[]
  albums             Album[]
  shareLinks         ShareLink[]
  storageUsage       StorageUsage?
  passwordResetTokens PasswordResetToken[]
}

model StorageUsage {
  id          String   @id @default(uuid())
  userId      String   @unique
  usedBytes   BigInt   @default(0)
  limitBytes  BigInt   @default(5000000000000) // 5 TB = 5,000,000,000,000 bytes
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id            String       @id @default(uuid())
  ownerId       String
  fileName      String
  originalName  String
  mimeType      String
  fileSize      BigInt
  fileHash      String       // SHA-256 for duplicate detection
  storagePath   String
  thumbnailPath String?
  width         Int?
  height        Int?
  duration      Float?       // Video duration in seconds
  isFavorite    Boolean      @default(false)
  isArchived    Boolean      @default(false)
  isDeleted     Boolean      @default(false)
  deletedAt     DateTime?
  takenAt       DateTime?
  cameraModel   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  albumItems    AlbumMedia[]
  shareLinks    ShareLink[]

  @@index([ownerId])
  @@index([ownerId, isDeleted, isArchived])
  @@index([ownerId, isFavorite])
  @@index([fileHash])
  @@index([createdAt])
}

model Album {
  id           String       @id @default(uuid())
  ownerId      String
  title        String
  description  String?
  coverMediaId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items        AlbumMedia[]
  shareLinks   ShareLink[]

  @@index([ownerId])
}

model AlbumMedia {
  id        String   @id @default(uuid())
  albumId   String
  mediaId   String
  addedAt   DateTime @default(now())

  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([albumId, mediaId])
  @@index([albumId])
  @@index([mediaId])
}

model ShareLink {
  id            String    @id @default(uuid())
  tokenHash     String    @unique // Secure random token lookup
  ownerId       String
  mediaId       String?
  albumId       String?
  expiresAt     DateTime?
  allowDownload Boolean   @default(true)
  isActive      Boolean   @default(true)
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media         Media?    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  album         Album?    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([ownerId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}
