# ==========================================
# MEMOPIX — 5 TB Private Photo & Video Cloud
# Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development

# Database Connection (SQLite default for local instant run, or PostgreSQL: postgresql://user:password@localhost:5432/memopix)
DATABASE_URL="file:./dev.db"

# JWT Security
JWT_SECRET=memopix_super_secret_jwt_key_5tb_production_2026_x89a7f3
JWT_EXPIRES_IN=7d

# Storage Configuration (5 TB = 5,000,000,000,000 bytes)
STORAGE_LIMIT_BYTES=5000000000000
STORAGE_DRIVER=local
STORAGE_BUCKET=memopix-private-media
LOCAL_STORAGE_PATH=./storage_data

# Optional Cloud Storage (Supabase Storage / S3 / R2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
